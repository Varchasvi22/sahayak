# ==============================================================================
# SAHAYAK (सहायक) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or configure in Vercel / Cloud Dashboard.
# NEVER commit your actual .env file with secrets into version control.

# Application Metadata
VITE_APP_NAME="Sahayak"
VITE_APP_ENV="development" # Set to "production" in live environments

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Statutory Database & Real-time Auth)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> API:
# 1. Project URL (e.g., https://your-project-ref.supabase.co)
# 2. Project API Anon/Public Key (Safe for client browser use with RLS enabled)
#
# IMPORTANT: DO NOT expose the "service_role" secret key here!
# Only the public "anon" key belongs in VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI ASSISTANT CONFIGURATION (Server-Side Only)
# ------------------------------------------------------------------------------
# Optional: Enables grounded natural language guidance for scheme terminology.
# If omitted or unconfigured, Sahayak gracefully falls back to deterministic
# grounded rules retrieval with zero runtime crashes or hallucinations.
#
# NOTE: In local dev (Vite dev server) this is read from process.env on the server.
# In serverless/production deployments, configure this as an environment secret.
GEMINI_API_KEY="your-google-gemini-api-key"
