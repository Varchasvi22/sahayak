# SAHAYAK - Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual Supabase credentials

VITE_APP_NAME="Sahayak"
VITE_APP_ENV="development"

# Supabase Credentials (from your Supabase project dashboard -> Settings -> API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
